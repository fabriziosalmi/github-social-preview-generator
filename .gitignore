# Upstream font binaries: build inputs, fetched and verified by
# tools/vendor_fonts.py against src/gspg/assets/fonts/fonts.lock.json. The
# committed glyph packs are what the renderer actually reads.
/vendor/

# Assembled gallery site: derived from previews/ on every build.
/site/

# Intermediate SVG. Regenerated by `make build`, and previews.lock.json already
# records the SHA-256 of every one, so committing 17 MB of them would add bulk
# without adding any verification `gspg build --check` does not already do.
/previews/svg/

# Ad-hoc renders from `gspg preview`.
/previews/scratch/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editors and operating systems
.DS_Store
.idea/
.vscode/
*.swp

# Working notes and generated reports. These are internal: they change on
# every run, say nothing a reader of the repository needs, and only add noise
# to a diff.
/COVERAGE.md
/previews/coverage.json
/proposals/
/notes/
/scratch/
